<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.GUI.MainWindow">
   <children>
      <VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" spacing="5.0">
         <children>
            <Label alignment="TOP_LEFT" contentDisplay="CENTER" nodeOrientation="LEFT_TO_RIGHT" text="Number of Program States" VBox.vgrow="NEVER">
               <font>
                  <Font name="Liberation Sans" size="12.0" />
               </font>
            </Label>
            <TextField fx:id="numPrgStatesField" editable="false" maxHeight="-Infinity" maxWidth="-Infinity" nodeOrientation="LEFT_TO_RIGHT" prefHeight="20.0" prefWidth="243.0" VBox.vgrow="NEVER" />
            <GridPane hgap="5.0" prefHeight="538.0" prefWidth="797.0" vgap="5.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints prefHeight="15.0" vgrow="NEVER" />
                <RowConstraints maxHeight="200.0" minHeight="10.0" prefHeight="175.0" vgrow="ALWAYS" />
                <RowConstraints prefHeight="15.0" vgrow="NEVER" />
                  <RowConstraints maxHeight="200.0" minHeight="10.0" prefHeight="175.0" vgrow="ALWAYS" />
                  <RowConstraints maxHeight="50.0" minHeight="2.3333333333333144" prefHeight="50.0" vgrow="NEVER" />
              </rowConstraints>
               <children>
                  <Label text="Program State IDs" textAlignment="CENTER" GridPane.halignment="CENTER" GridPane.valignment="CENTER" />
                  <Label text="Symbol Table" textAlignment="CENTER" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.valignment="CENTER" />
                  <Label text="File Table" textAlignment="CENTER" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.valignment="CENTER" />
                  <Label text="Execution Stack" textAlignment="CENTER" GridPane.halignment="CENTER" GridPane.rowIndex="2" GridPane.valignment="CENTER" />
                  <Label text="Heap Table" textAlignment="CENTER" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="2" GridPane.valignment="CENTER" />
                  <Label text="Out" textAlignment="CENTER" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.rowIndex="2" GridPane.valignment="CENTER" />
                  <ListView fx:id="prgStateLView" prefHeight="200.0" prefWidth="200.0" GridPane.rowIndex="1" />
                  <ListView fx:id="exeStackLView" prefHeight="200.0" prefWidth="200.0" GridPane.rowIndex="3" />
                  <ListView fx:id="fileTableLView" prefHeight="200.0" prefWidth="200.0" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                  <ListView fx:id="outLView" prefHeight="200.0" prefWidth="200.0" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                  <Button fx:id="runOneStepButton" mnemonicParsing="false" text="Run One Step" GridPane.halignment="CENTER" GridPane.rowIndex="4" GridPane.valignment="BOTTOM" />
                  <Button fx:id="runAllStepsButton" mnemonicParsing="false" text="Run All Steps" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="4" GridPane.valignment="BOTTOM" />
                  <Button fx:id="openLogFileButton" mnemonicParsing="false" text="Open Log FIle" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.rowIndex="4" GridPane.valignment="BOTTOM" />
                  <TableView fx:id="symTableTView" prefHeight="200.0" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <columns>
                      <TableColumn prefWidth="125.0" resizable="false" text="Variable Name" />
                      <TableColumn prefWidth="125.0" resizable="false" text="Value" />
                    </columns>
                  </TableView>
                  <TableView fx:id="heapTableTView" prefHeight="200.0" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <columns>
                      <TableColumn editable="false" prefWidth="125.0" resizable="false" text="Address" />
                      <TableColumn editable="false" prefWidth="125.0" resizable="false" sortable="false" text="Value" />
                    </columns>
                  </TableView>
               </children>
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </VBox.margin>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </GridPane>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
